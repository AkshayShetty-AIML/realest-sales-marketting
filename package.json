{
  "name": "sales-automation-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:seed": "node --env-file-if-exists=.env.local --require ./scripts/allow-server-only.cjs --import tsx scripts/seed.ts",
    "verify": "tsx --require ./scripts/allow-server-only.cjs scripts/verify-unit.ts && tsx --require ./scripts/allow-server-only.cjs scripts/verify-desk.ts",
    "verify:bundle": "node --env-file-if-exists=.env.local --import tsx scripts/verify-bundle.ts",
    "verify:live": "node --env-file-if-exists=.env.local --require ./scripts/allow-server-only.cjs --import tsx scripts/verify-live.ts",
    "verify:batch2": "node --env-file-if-exists=.env.local --require ./scripts/allow-server-only.cjs --import tsx scripts/verify-batch2.ts",
    "verify:batch3": "node --env-file-if-exists=.env.local --require ./scripts/allow-server-only.cjs --import tsx scripts/verify-batch3.ts",
    "verify:marketing": "node --env-file-if-exists=.env.local --require ./scripts/allow-server-only.cjs --import tsx scripts/verify-marketing.ts",
    "verify:marketing-m2": "node --env-file-if-exists=.env.local --require ./scripts/allow-server-only.cjs --import tsx scripts/verify-marketing-m2.ts",
    "verify:marketing-m3": "node --env-file-if-exists=.env.local --require ./scripts/allow-server-only.cjs --import tsx scripts/verify-marketing-m3.ts",
    "verify:llm": "node --env-file-if-exists=.env.local --require ./scripts/allow-server-only.cjs --import tsx scripts/verify-llm.ts",
    "demo:lead": "node --env-file-if-exists=.env.local --require ./scripts/allow-server-only.cjs --import tsx scripts/demo-lead.ts",
    "demo:seed": "node --env-file-if-exists=.env.local --require ./scripts/allow-server-only.cjs --import tsx scripts/demo.ts seed",
    "demo:clear": "node --env-file-if-exists=.env.local --require ./scripts/allow-server-only.cjs --import tsx scripts/demo.ts clear",
    "verify:harness": "node --env-file-if-exists=.env.local --require ./scripts/allow-server-only.cjs --import tsx scripts/verify-harness.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.9",
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/supabase-js": "^2.117.2",
    "next": "^16.3.6",
    "openai": "^7.25.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
