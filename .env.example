# ═══════════════════════════════════════════════════════════════════════════
# Sales desk — copy to .env.local (gitignored). NEVER commit values.
# Every value is read SERVER-SIDE ONLY, in exactly one file: lib/env.ts.
# Runs on http://localhost:3001 (`npm run dev`); the premium app on :3000.
# ═══════════════════════════════════════════════════════════════════════════

# ── Premium app internal API (required) ─────────────────────────────────────
# The internal API base, and the SAME value as the premium app's
# SALES_INTERNAL_API_KEY (sent as x-service-key; 401 when wrong).
PREMIUM_API_BASE=http://localhost:3000/api/internal
SALES_INTERNAL_API_KEY=

# ── New-lead signal: the PREMIUM project's Supabase ─────────────────────────
# URL + ANON key only: the "leads" broadcast carries no lead data (premium
# migration 20261002000500). Blank → polling /leads?since= every 5 s instead.
PREMIUM_SUPABASE_URL=
PREMIUM_SUPABASE_ANON_KEY=

# ── Buyer links (booking / visit / feedback pages at /b/<token>) ──────────
# Where buyers open the links the desk sends in-app. Production: the public URL
# that routes /b/* (and /api/twilio/*) to this app — nothing else is public.
SALES_PUBLIC_BASE_URL=http://localhost:3001

# ── This app's OWN Supabase (sales state only) ──────────────────────────────
# Blank → local file store .data/sales-store.json (fine for localhost).
# Apply supabase/migrations/*.sql to that project first.
SALES_SUPABASE_URL=
SALES_SUPABASE_SECRET_KEY=

# ── Rep sign-in (Clerk) ─────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# Local demo with NO sign-in — served to localhost only (tunnels reach /api/twilio/* only).
SALES_ALLOW_UNAUTHENTICATED_DEMO=

# ── WhatsApp via Twilio ─────────────────────────────────────────────────────
# Twilio Console → Account Info (SID, Auth Token). Sandbox: Messaging → Try it
# out → Send a WhatsApp message (From = the sandbox number). Blank → WhatsApp off.
# Keep credentials but stop all Twilio traffic (no sends, no message-log polling).
WHATSAPP_PAUSED=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_MODE=sandbox
# Sandbox: send every WhatsApp to THIS number (your phone, joined to the
# sandbox) instead of the lead's. Blank → the lead's own number.
WHATSAPP_DEMO_TO=
# Approved template (Content SID "HX…") for messages outside the 24-hour window.
TWILIO_CONTENT_SID=
# Public URL that reaches this app, e.g. `ngrok http 3001` → https://xxxx.ngrok-free.app
# Then in Twilio set "When a message comes in" → <this>/api/twilio/inbound (POST).
TWILIO_WEBHOOK_BASE_URL=

# ── Email (marketing nurture + campaign sends; optional) ───────────────────
# Same seam as the premium app: each email is POSTed as JSON { to, subject, text }
# to EMAIL_WEBHOOK_URL (your provider's endpoint or a small relay), with
# EMAIL_WEBHOOK_TOKEN as a Bearer token. Blank → email is OFF (steps say so).
# Only MARKETING sequences / campaign sends use it; sales sequences keep email queued.
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=

# ── Grounded AI drafting (optional) ─────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Optional second provider (any OpenAI-compatible API) — lib/llm.ts falls back to it
# when Groq errors, rate-limits or returns bad output. All three must be set.
LLM_FALLBACK_NAME=fallback
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=
# Routing: default chain order, and per-route chains (LLM_ROUTE_<ROUTE>=name,name).
# e.g. LLM_PROVIDER_ORDER=groq,fallback   LLM_ROUTE_HARNESS_PLANNER=fallback,groq
LLM_PROVIDER_ORDER=

# ── Marketing agentic harness ───────────────────────────────────────────────
# Registers the harness's TEST stub tools + sub-agent types (no business logic)
# so goal intake can be exercised before features register. Never in production.
MARKETING_HARNESS_STUBS=false

# Pepper for hashing buyer phone numbers. Any long random string.
CONTACT_HASH_PEPPER=
